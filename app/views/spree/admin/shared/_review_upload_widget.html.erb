<div class='card'>
  <div class="card-header">
    Upload Review File(.cvs file only)
  </div>
  <div class='card-body text-center'>
    <p class="card-text text-left">
      <b>required columns</b>: 'rating', 'review_title', 'review_date', 'review_text', 'reviewer' <br>
      <b>optional columns</b>: 'helpful_vote' <br>
      <i>all other columns will be omitted</i>
    </p>
    <p class="card-text text-left">
    Or use google chrome extension
    <ol  class="card-text text-left">
      <li class="Item_17b40">Download the browser extension
        <a href="https://chromewebstore.google.com/detail/amazon-reviews-extractor/aapmfnbcggnbcghjipmpcngmflbjjfnb" target="_blank" rel="noopener noreferrer" style="text-decoration: underline; color: inherit;">Amazon
          Reviews Extractor</a>  or <a href="https://chromewebstore.google.com/detail/amazon-reviews-extractor/npniokkcbjelfdcbpfdpkgapmdoimfdk" target="_blank" rel="noopener noreferrer" style="text-decoration: underline; color: inherit;">Amazon
        Reviews Extractor</a>  available for Chrome.
      </li>
      <li class="Item_17b40">Navigate to the product page for which you want to export reviews.</li>
      <li class="Item_17b40">Open the extension, sign in or create your account. Click 'Export reviews'.</li>
      <li class="Item_17b40">This will typically save the reviews in a CSV file format on your computer.</li>
      <li class="Item_17b40">Add the file below.</li>
    </ol>

    </p>
    <%= form_tag file_upload_admin_product_reviews_path(@product), method: :post, multipart: true do |f| %>
      <div class="input-group mb-3">
        <div class="custom-file">
          <%= file_field_tag :review_file, class: "", accept: 'text/csv', required: true %>
        </div>
      </div>
      <button class='btn btn-primary'>Upload</button>
    <% end %>
  </div>
</div>
